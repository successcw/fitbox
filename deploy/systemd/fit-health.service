[Unit]
Description=Fitbox Health Auto Export receiver
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=__USER__
Environment=HOME=__HOME__
Environment=FITBOX_CONFIG=__HOME__/.config/fitbox/config.env
EnvironmentFile=__HOME__/.config/fitbox/config.env
WorkingDirectory=__PROJECT__
ExecStart=__PYTHON__ __PROJECT__/fitbox/health_receiver.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__HOME__/fitdata
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
