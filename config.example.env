# Copy to config.local.env, or ~/.config/fitbox/config.env (chmod 600).
# Use absolute paths. Environment variables override values in this file.
FITBOX_HOSTS='fitbox.local'
FITBOX_SSH_USER=''
FITBOX_TIMEZONE='Asia/Shanghai'
# FITBOX_DATA_ROOT='/absolute/path/to/private-data'
# CHROME_BIN='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
# FITBOX_HOME_CONNECTION='your-saved-NetworkManager-home-profile'
# Optional body composition: omit all three to record weight/impedance only.
# FITBOX_HEIGHT_CM='170'
# FITBOX_AGE='35'
# FITBOX_SEX='female'
# FITBOX_WEIGHT_GOAL_KG='65'
# Optional filter when multiple people share one scale.
# FITBOX_WEIGHT_MIN_KG='40'
# FITBOX_WEIGHT_MAX_KG='100'
# Receiver binds only to loopback until you set its Tailscale IPv4 address.
FITBOX_HEALTH_BIND='127.0.0.1'
FITBOX_HEALTH_PORT='8787'
# FITBOX_HEALTH_TOKEN_FILE='/absolute/path/to/health.token'
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''
